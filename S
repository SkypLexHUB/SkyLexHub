-- ฟังก์ชันเพิ่มข้อความ Log ลง UI และบันทึกลงไฟล์
local function addLog(text)
    -- บันทึกลงไฟล์ใน Workspace อัตโนมัติ
    saveLogToFile(text)

    -- แสดงผลบน UI
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 0)
    label.AutomaticSize = Enum.AutomaticSize.Y
    label.BackgroundTransparency = 0.7
    label.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    label.TextColor3 = Color3.fromRGB(230, 230, 230)
    label.TextSize = 12
    label.Font = Enum.Font.Code
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Top
    label.TextWrapped = true
    label.Text = text
    label.Parent = ScrollingFrame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = label
    
    local padding = Instance.new("UIPadding")
    padding.PaddingTop = UDim.new(0, 6)
    padding.PaddingBottom = UDim.new(0, 6)
    padding.PaddingLeft = UDim.new(0, 8)
    padding.PaddingRight = UDim.new(0, 8)
    padding.Parent = label
end

-- ดักจับการเรียกใช้งาน Remote ผ่าน __namecall
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if self.Name == "BuyWight" and (method == "FireServer" or method == "InvokeServer") then
        local timeStr = os.date("%H:%M:%S")
        local argString = ""
        for i, v in ipairs(args) do
            argString = argString .. string.format("  [%d] %s (%s)\n", i, tostring(v), typeof(v))
        end
        if #args == 0 then
            argString = "  (No Arguments)\n"
        end
        
        local logText = string.format("[%s] Method: %s\nArguments:\n%s", timeStr, method, argString)
        addLog(logText)
    end
    
    return oldNamecall(self, ...)
end)

addLog("System initialized: Hooked 'BuyWight' & saving to Workspace/" .. folderName)
