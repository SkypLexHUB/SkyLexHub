-- ตรวจสอบว่าเกมถูกต้อง (Saber Simulator)
if game.PlaceId ~= 3823781113 then
    warn("กรุณาใช้สคริปต์นี้ในเกม Saber Simulator เท่านั้น!")
end

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Player = Players.LocalPlayer

-- ดึง Remote Events จาก Dump
local Events = ReplicatedStorage:WaitForChild("Events")
local SwingSaberRemote = Events:WaitForChild("SwingSaber")
local SellStrengthRemote = Events:WaitForChild("SellStrength")
local UIActionRemote = Events:WaitForChild("UIAction")

-- ตัวแปรควบคุมสถานะ (Toggles)
getgenv().AutoClick = false
getgenv().AutoSell = false
getgenv().AutoBuySaber = false
getgenv().AutoBuyDNA = false
getgenv().AutoBuyClass = false

-- 1. ระบบ Auto Click (ฟันดาบออโต้)
task.spawn(function()
    while true do
        if getgenv().AutoClick then
            pcall(function()
                SwingSaberRemote:FireServer()
            end)
        end
        task.wait(0.05)
    end
end)

-- 2. ระบบ Auto Sell Strength (ขายพลังออโต้)
task.spawn(function()
    while true do
        if getgenv().AutoSell then
            pcall(function()
                SellStrengthRemote:FireServer()
            end)
        end
        task.wait(1)
    end
end)

-- 3. ระบบ Auto Buy Best Sabers (ซื้อดาบที่ดีที่สุด)
task.spawn(function()
    while true do
        if getgenv().AutoBuySaber then
            pcall(function()
                UIActionRemote:FireServer("BuyBestSaber")
            end)
        end
        task.wait(2)
    end
end)

-- 4. ระบบ Auto Buy Best DNA (ซื้อกระเป๋า DNA ที่ดีที่สุด)
