local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()
local UserInputService = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")

-- สร้าง ScreenGui สำหรับแสดงวงกลมจุดที่มาโครกด
local VisualGui = Instance.new("ScreenGui")
VisualGui.Name = "MacroVisualizer"
VisualGui.IgnoreGuiInset = true
VisualGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

-- ป้องกันไม่ให้แอปพังถ้าใส่ CoreGui ไม่ได้
pcall(function()
    VisualGui.Parent = CoreGui
end)
if not VisualGui.Parent then
    VisualGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")
end

-- ฟังก์ชันสร้างวงกลมแสดงตำแหน่งที่กด
local function showTouchIndicator(x, y)
    local dot = Instance.new("Frame")
    dot.Size = UDim2.fromOffset(40, 40)
    dot.AnchorPoint = Vector2.new(0.5, 0.5)
    dot.Position = UDim2.fromOffset(x, y)
    dot.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    dot.BackgroundTransparency = 0.2
    dot.BorderSizePixel = 0

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = dot

    dot.Parent = VisualGui

    -- แอนิเมชันขยายออกและจางหายไป
    TweenService:Create(dot, TweenInfo.new(0.3), {
        Size = UDim2.fromOffset(80, 80),
        BackgroundTransparency = 1
    }):Play()

    task.delay(0.3, function()
        dot:Destroy()
    end)
end

local Window = WindUI:CreateWindow({
    Title = "Macro Recorder Mobile2",
    Icon = "rbxassetid://4483345998",
    Author = "Auto Macro",
    Folder = "MacroSettings",
    Size = UDim2.fromOffset(550, 380),
    Transparent = true,
    Theme = "Dark",
})

local MainTab = Window:Tab({
    Title = "Macro Controls",
    Icon = "play",
})

local isRecording = false
local isPlaying = false
local recordedEvents = {}
local startTime = 0
local macroFileName = "default_macro"

local StatusLabel = MainTab:Paragraph({
    Title = "สถานะระบบ",
    Content = "สถานะ: พร้อมใช้งาน (ยังไม่ได้อัด)",
})

local function startRecording()
    recordedEvents = {}
    startTime = tick()
    isRecording = true
    StatusLabel:SetDesc("สถานะ: กำลังอัดหน้าจอ... (จิ้มหน้าจอได้เลย)")
    WindUI:Notify({
        Title = "Macro Recorder",
        Content = "เริ่มบันทึกการสัมผัสหน้าจอแล้ว!",
        Duration = 2,
    })
end

local function stopRecording()
    isRecording = false
    StatusLabel:SetDesc("สถานะ: หยุดอัดแล้ว (บันทึกได้ " .. #recordedEvents .. " คำสั่ง)")
    WindUI:Notify({
        Title = "Macro Recorder",
        Content = "หยุดบันทึก! ได้ทั้งหมด " .. #recordedEvents .. " รายการ",
        Duration = 3,
    })
end

local function playMacro()
    if isRecording then return end
    if #recordedEvents == 0 then
        WindUI:Notify({
            Title = "Macro Recorder",
            Content = "ไม่มีข้อมูล Macro ให้เล่น!",
            Duration = 3,
        })
        return
    end

    isPlaying = true
    StatusLabel:SetDesc("สถานะ: กำลังเล่น Macro ซ้ำ...")
    WindUI:Notify({
        Title = "Macro Recorder",
        Content = "กำลังเล่น Macro...",
        Duration = 2,
    })

    task.spawn(function()
        local playStartTime = tick()
        for i, event in ipairs(recordedEvents) do
            if not isPlaying then break end

            local targetTime = playStartTime + event.delay
            local waitTime = targetTime - tick()
            if waitTime > 0 then
                task.wait(waitTime)
            end

            if not isPlaying then break end

            if event.type == "Keyboard" then
                local keyCode = Enum.KeyCode[event.key]
                if keyCode then
                    VirtualInputManager:SendKeyEvent(event.state, keyCode, false, game)
                end
            elseif event.type == "Touch" then
                -- สั่งให้มือถือจำลองการกด
                VirtualInputManager:SendTouchEvent(0, event.x, event.y, event.state, game)
                
                -- แสดงวงกลมสีแดงตรงจุดที่มาโครกด เฉพาะตอนกดลง (state == true)
                if event.state then
                    showTouchIndicator(event.x, event.y)
                end
            end
        end
        isPlaying = false
        StatusLabel:SetDesc("สถานะ: เล่น Macro เสร็จสิ้น")
        WindUI:Notify({
            Title = "Macro Recorder",
            Content = "เล่น Macro เสร็จสิ้น",
            Duration = 2,
        })
    end)
end

local function stopMacro()
    isPlaying = false
    StatusLabel:SetDesc("สถานะ: หยุดการเล่นแล้ว")
    WindUI:Notify({
        Title = "Macro Recorder",
        Content = "หยุดการเล่น Macro แล้ว",
        Duration = 2,
    })
end

local function saveMacro()
    if #recordedEvents == 0 then
        WindUI:Notify({
            Title = "Error",
            Content = "ไม่มีข้อมูลให้บันทึก",
            Duration = 2,
        })
        return
    end

    local success, err = pcall(function()
        local json = HttpService:JSONEncode(recordedEvents)
        writefile(macroFileName .. ".json", json)
    end)

    if success then
        WindUI:Notify({
            Title = "Save Successful",
            Content = "บันทึกไฟล์ " .. macroFileName .. ".json เรียบร้อย!",
            Duration = 3,
        })
    else
        WindUI:Notify({
            Title = "Save Failed",
            Content = "เกิดข้อผิดพลาด: " .. tostring(err),
            Duration = 3,
        })
    end
end

local function loadMacro()
    if not isfile(macroFileName .. ".json") then
        WindUI:Notify({
            Title = "Error",
            Content = "ไม่พบไฟล์ " .. macroFileName .. ".json",
            Duration = 3,
        })
        return
    end

    local success, err = pcall(function()
        local content = readfile(macroFileName .. ".json")
        recordedEvents = HttpService:JSONDecode(content)
    end)

    if success then
        StatusLabel:SetDesc("สถานะ: โหลดไฟล์สำเร็จ (" .. #recordedEvents .. " คำสั่ง)")
        WindUI:Notify({
            Title = "Load Successful",
            Content = "โหลดสำเร็จ! (" .. #recordedEvents .. " รายการ)",
            Duration = 3,
        })
    else
        WindUI:Notify({
            Title = "Load Failed",
            Content = "โหลดไม่สำเร็จ: " .. tostring(err),
            Duration = 3,
        })
    end
end

UserInputService.InputBegan:Connect(function(input)
    if not isRecording then return end

    if input.UserInputType == Enum.UserInputType.Keyboard then
        table.insert(recordedEvents, {
            type = "Keyboard",
            key = input.KeyCode.Name,
            state = true,
            delay = tick() - startTime
        })
    elseif input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        local pos = input.Position
        table.insert(recordedEvents, {
            type = "Touch",
            x = pos.X,
            y = pos.Y,
            state = true,
            delay = tick() - startTime
        })
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if not isRecording then return end

    if input.UserInputType == Enum.UserInputType.Keyboard then
        table.insert(recordedEvents, {
            type = "Keyboard",
            key = input.KeyCode.Name,
            state = false,
            delay = tick() - startTime
        })
    elseif input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        local pos = input.Position
        table.insert(recordedEvents, {
            type = "Touch",
            x = pos.X,
            y = pos.Y,
            state = false,
            delay = tick() - startTime
        })
    end
end)

