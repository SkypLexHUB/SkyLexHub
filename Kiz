-- ===== อัปเดต ESP + เส้น =====
RunService.RenderStepped:Connect(function()
    local Camera = workspace.CurrentCamera
    if not (ESPEnabled and Camera) then return end

    local viewport = Camera.ViewportSize
    local origin = Vector2.new(viewport.X / 2, viewport.Y)

    for player, obj in pairs(ESPObjects) do
        local character = player.Character
        local head = character and character:FindFirstChild("Head")
        local root = character and character:FindFirstChild("HumanoidRootPart")

        if head then
            local d = (head.Position - Camera.CFrame.Position).Magnitude
            obj.Label.Text = string.format("%s [%dm]", player.DisplayName, d)
        end

        if LineEnabled and root then
            local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
            if onScreen and pos.Z > 0 then
                local to = Vector2.new(pos.X, pos.Y)
                local delta = to - origin
                obj.Line.Size = UDim2.fromOffset(delta.Magnitude, 2)
                obj.Line.Position = UDim2.fromOffset(
                    (origin.X + to.X) / 2,
                    (origin.Y + to.Y) / 2
                )
                obj.Line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
                obj.Line.Visible = true
            else
                obj.Line.Visible = false
            end
        else
            obj.Line.Visible = false
        end
    end
end)

-- ===== ล็อกกล้องที่ Head (Aim Assist) =====
RunService:BindToRenderStep("AimLockHead", Enum.RenderPriority.Camera.Value + 1, function()
    if not AimEnabled then return end
    local Camera = workspace.CurrentCamera
    if not Camera then return end

    CurrentTarget = GetNearestTarget()
    local head = CurrentTarget
        and CurrentTarget.Character
        and CurrentTarget.Character:FindFirstChild("Head")

    if head then
        local goal = CFrame.lookAt(Camera.CFrame.Position, head.Position)
        if InstantSnap then
            Camera.CFrame = goal
        else
            Camera.CFrame = Camera.CFrame:Lerp(goal, Smoothness)
        end
    end
end)

-- ===== Silent Aim (Hook Raycast แบบป้องกันลูป - ไม่เด้ง) =====
local isProcessing = false

pcall(function()
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        if not SilentAimEnabled or isProcessing then
            return oldNamecall(self, ...)
        end
        
        local method = getnamecallmethod()
        if self == workspace and method == "Raycast" then
            isProcessing = true
            local args = {...}
            local target = GetNearestTarget()
            
            if target and target.Character and target.Character:FindFirstChild("Head") then
                local origin = args[1]
                local headPos = target.Character.Head.Position
                args[2] = (headPos - origin).Unit * 5000 
            end
            
            isProcessing = false
            return oldNamecall(self, unpack(args))
        end
        
        return oldNamecall(self, ...)
    end)
end)

