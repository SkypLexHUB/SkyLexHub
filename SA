local Tab = Window:CreateTab("Logger Info", 4483362458)

-- แสดงสถานะการทำงานผ่าน Paragraph
local StatusParagraph = Tab:CreateParagraph({
    Title = "สถานะระบบ (Status)",
    Content = "กำลังรอการเรียกใช้งาน Remote ('BuyWight')...\n- บันทึกทั้งหมด: 0 รายการ\n- ไฟล์ปัจจุบัน: " .. currentFileName
})

-- ปุ่มสำหรับคัดลอกชื่อโฟลเดอร์
Tab:CreateButton({
