-- ตรวจสอบฟังก์ชัน Hook และระบบไฟล์ของ Executor
if not getrawmetatable or not hookmetamethod or not writefile or not appendfile then
    warn("Executor ของคุณไม่รองรับฟังก์ชันที่จำเป็น (Hook หรือ File System)!")
    return
end

-- สร้างโฟลเดอร์เก็บ Log ใน Workspace
local folderName = "BuyWightLogs"
if not isfolder(folderName) then
    makefolder(folderName)
end

-- ตั้งค่าระบบจัดการไฟล์ (สูงสุด 500 บันทึกต่อ 1 ไฟล์)
local fileIndex = 1
local logCountInCurrentFile = 0
local maxLogsPerFile = 500
local totalLogsCaptured = 0

local function getNewFileName()
    return string.format("%s/BuyWight_Log_%s_%d.txt", folderName, os.date("%Y%m%d_%H%M%S"), fileIndex)
end

local currentFileName = getNewFileName()

-- เขียนหัวไฟล์แรกสุด
writefile(currentFileName, string.format("=== BuyWight Remote Dump Log Started: %s ===\n\n", os.date("%Y-%m-%d %H:%M:%S")))

local function saveLogToFile(text)
    logCountInCurrentFile = logCountInCurrentFile + 1
    totalLogsCaptured = totalLogsCaptured + 1
    
    -- ถ้าข้อมูลในไฟล์ปัจจุบันเกิน 500 บันทึก ให้สร้างไฟล์ใหม่
    if logCountInCurrentFile > maxLogsPerFile then
        fileIndex = fileIndex + 1
        currentFileName = getNewFileName()
        logCountInCurrentFile = 1
        writefile(currentFileName, string.format("=== BuyWight Remote Dump Log (Part %d) Started: %s ===\n\n", fileIndex, os.date("%Y-%m-%d %H:%M:%S")))
    end
    
    -- ต่อข้อความลงในไฟล์ปัจจุบัน
    appendfile(currentFileName, text .. "\n" .. string.rep("-", 50) .. "\n")
end

-- โหลด Rayfield UI Library
local success, Rayfield = pcall(function()
    return loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
end)

if not success or not Rayfield then
    warn("ไม่สามารถโหลด Rayfield UI ได้ โปรดตรวจสอบการเชื่อมต่ออินเทอร์เน็ต!")
    return
end

