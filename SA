                Duration = 3
            })
        end
    end,
})

-- ดักจับการเรียกใช้งาน Remote ผ่าน __namecall (รองรับทั้ง RemoteEvent และ RemoteFunction)
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if self.Name == "BuyWight" then
        local timeStr = os.date("%H:%M:%S")
        
        if method == "FireServer" then
            -- กรณี RemoteEvent
            local argString = ""
            for i, v in ipairs(args) do
                argString = argString .. string.format("  [%d] %s (%s)\n", i, tostring(v), typeof(v))
            end
            if #args == 0 then argString = "  (No Arguments)\n" end
            
            local logText = string.format("[%s] Type: RemoteEvent (FireServer)\nArguments:\n%s", timeStr, argString)
            saveLogToFile(logText)
            
            -- อัปเดตข้อความใน Rayfield Paragraph
            pcall(function()
                StatusParagraph:Set({
                    Title = "สถานะล่าสุด (RemoteEvent)",
                    Content = string.format("เวลาล่าสุด: %s\n- บันทึกทั้งหมด: %d รายการ\n- ไฟล์ปัจจุบัน: %s", timeStr, totalLogsCaptured, currentFileName)
                })
            end)
            
        elseif method == "InvokeServer" then
            -- กรณี RemoteFunction (ดักจับทั้ง Arguments และ Return Value จากเซิร์ฟเวอร์)
            local argString = ""
            for i, v in ipairs(args) do
                argString = argString .. string.format("  [%d] %s (%s)\n", i, tostring(v), typeof(v))
            end
            if #args == 0 then argString = "  (No Arguments)\n" end
            
            -- รันคำสั่งจริงเพื่อให้ได้ค่า Return กลับมา
            local results = { oldNamecall(self, unpack(args)) }
            
            local returnString = ""
            for i, v in ipairs(results) do
                returnString = returnString .. string.format("  [%d] %s (%s)\n", i, tostring(v), typeof(v))
            end
            if #results == 0 then returnString = "  (No Return Value)\n" end
            
            local logText = string.format("[%s] Type: RemoteFunction (InvokeServer)\nArguments:\n%sReturns:\n%s", timeStr, argString, returnString)
            saveLogToFile(logText)
            
            -- อัปเดตข้อความใน Rayfield Paragraph
            pcall(function()
                StatusParagraph:Set({
                    Title = "สถานะล่าสุด (RemoteFunction)",
                    Content = string.format("เวลาล่าสุด: %s\n- บันทึกทั้งหมด: %d รายการ\n- ไฟล์ปัจจุบัน: %s", timeStr, totalLogsCaptured, currentFileName)
                })
            end)
            
            return unpack(results)
        end
    end
    
    return oldNamecall(self, ...)
end)

