-- สร้างโฟลเดอร์เก็บ Log ใน Workspace
local folderName = "BuyWightLogs"
if not isfolder(folderName) then
    makefolder(folderName)
end

-- ฟังก์ชันสำหรับแปลง Table ให้เป็นข้อความโครงสร้างยาวๆ (Deep Table to String)
local function serializeTable(val, indent)
    indent = indent or 0
    local formatting = string.rep("  ", indent)
    
    if type(val) == "table" then
        local result = "{\n"
        for k, v in pairs(val) do
            local keyStr = tostring(k)
            if type(k) == "string" then
                keyStr = string.format("%q", k)
            end
            result = result .. formatting .. "  [" .. keyStr .. "] = " .. serializeTable(v, indent + 1) .. ",\n"
        end
        return result .. formatting .. "}"
    elseif type(val) == "string" then
        return string.format("%q", val)
    else
        return tostring(val) .. " (" .. type(val) .. ")"
    end
end

-- ตั้งค่าระบบจัดการไฟล์ (สูงสุด 500 บันทึกต่อ 1 ไฟล์)
local fileIndex = 1
local logCountInCurrentFile = 0
local maxLogsPerFile = 500
local totalLogsCaptured = 0

local function getNewFileName()
    return string.format("%s/BuyWight_Log_%s_%d.txt", folderName, os.date("%Y%m%d_%H%M%S"), fileIndex)
end

local currentFileName = getNewFileName()
writefile(currentFileName, string.format("=== BuyWight Deep Dump Log Started: %s ===\n\n", os.date("%Y-%m-%d %H:%M:%S")))

local function saveLogToFile(text)
    logCountInCurrentFile = logCountInCurrentFile + 1
    totalLogsCaptured = totalLogsCaptured + 1
    
    if logCountInCurrentFile > maxLogsPerFile then
        fileIndex = fileIndex + 1
        currentFileName = getNewFileName()
        logCountInCurrentFile = 1
        writefile(currentFileName, string.format("=== BuyWight Deep Dump Log (Part %d) Started: %s ===\n\n", fileIndex, os.date("%Y-%m-%d %H:%M:%S")))
    end
    
    appendfile(currentFileName, text .. "\n" .. string.rep("=", 60) .. "\n")
end

