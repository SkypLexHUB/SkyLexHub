-- ดักจับการเรียกใช้งาน Remote
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if self.Name == "BuyWight" then
        local timeStr = os.date("%H:%M:%S")
        
        if method == "FireServer" or method == "InvokeServer" then
            local argString = ""
            for i, v in ipairs(args) do
                -- ใช้ฟังก์ชัน serializeTable เพื่อเปิดดูข้อมูลข้างใน Table ทั้งหมดอย่างละเอียด
                argString = argString .. string.format("  Argument [%d]:\n%s\n", i, serializeTable(v, 1))
            end
            if #args == 0 then argString = "  (No Arguments)\n" end
            
            local returnString = ""
            local results = {}
            
            if method == "InvokeServer" then
                results = { oldNamecall(self, unpack(args)) }
                for i, v in ipairs(results) do
                    returnString = returnString .. string.format("  Return [%d]:\n%s\n", i, serializeTable(v, 1))
                end
                if #results == 0 then returnString = "  (No Return Value)\n" end
            end
            
            local logText = string.format("[%s] Method: %s\n%s%s", timeStr, method, argString, (method == "InvokeServer" and ("Returns:\n" .. returnString) or ""))
            
            -- บันทึกลงไฟล์ใน Workspace ทันทีแบบครบถ้วน ไม่จำกัดความยาวบนจอ
            saveLogToFile(logText)
            
            pcall(function()
                StatusParagraph:Set({
                    Title = "บันทึกล่าสุดสำเร็จ (" .. method .. ")",
                    Content = string.format("เวลา: %s | ทั้งหมด: %d รายการ\nไฟล์: %s", timeStr, totalLogsCaptured, currentFileName)
                })
            end)
            
            if method == "InvokeServer" then
                return unpack(results)
            end
        end
    end
    
    return oldNamecall(self, ...)
end)

