-- ตรวจสอบว่าเกมถูกต้อง (Saber Simulator)
if game.PlaceId ~= 3823781113 then
    warn("กรุณาใช้สคริปต์นี้ในเกม Saber Simulator เท่านั้น!")
end

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local Player = Players.LocalPlayer

-- ดึง Remote Events หลัก
local Events = ReplicatedStorage:WaitForChild("Events")
local SwingSaberRemote = Events:WaitForChild("SwingSaber")
local SellStrengthRemote = Events:WaitForChild("SellStrength")
local UIActionRemote = Events:WaitForChild("UIAction")
local CollectCurrencyRemote = Events:WaitForChild("CollectCurrencyPickup")

-- ตัวแปรควบคุมสถานะ (Toggles)
getgenv().AutoClick = false
getgenv().AutoSell = false
getgenv().AutoBuySaber = false
getgenv().AutoBuyDNA = false
getgenv().AutoBuyClass = false
getgenv().AutoBuyEgg = false
getgenv().SelectedEgg = "HD Egg" -- ค่าเริ่มต้นของไข่ที่จะสุ่ม

-- ตัวแปรควบคุมสถานะ Halloween
getgenv().AutoCollectLollipop = false
getgenv().AutoAttackBoss = false

--------------------------------------------------------------------------------
-- 🔹 ลูปทำงานฟังก์ชันหลัก
--------------------------------------------------------------------------------

-- 1. ระบบ Auto Click (ฟันดาบออโต้)
task.spawn(function()
    while true do
        if getgenv().AutoClick then
            pcall(function()
                SwingSaberRemote:FireServer()
            end)
        end
        task.wait(0.05)
    end
end)

-- 2. ระบบ Auto Sell Strength (ขายพลังออโต้)
task.spawn(function()
    while true do
        if getgenv().AutoSell then
            pcall(function()
                SellStrengthRemote:FireServer()
            end)
        end
        task.wait(1)
    end
end)

-- 3. ระบบ Auto Buy Weapons (ซื้อดาบออโต้)
task.spawn(function()
    while true do
        if getgenv().AutoBuySaber then
            pcall(function()
                UIActionRemote:FireServer("BuyAllWeapons")
            end)
        end
        task.wait(2)
    end
end)

-- 4. ระบบ Auto Buy DNAs (ซื้อกระเป๋า DNA ออโต้)
task.spawn(function()
    while true do
        if getgenv().AutoBuyDNA then
            pcall(function()
                UIActionRemote:FireServer("BuyAllDNAs")
            end)
        end
        task.wait(2)
    end
end)

-- 5. ระบบ Auto Buy Class (ดึงชื่อจาก TextLabel หน้าจอมาซื้อออโต้)
task.spawn(function()
    while true do
        if getgenv().AutoBuyClass then
            pcall(function()
                local className = Player.PlayerGui.MainGui.OtherFrames.Shop.Frames.Classes.InfoFrame.Frame.ItemName.TextLabel.Text
                if className and className ~= "" then
                    UIActionRemote:FireServer("BuyClass", className)
                end
            end)
        end
        task.wait(0.5)
    end
end)

-- 6. ระบบ Auto Buy Egg (สุ่มไข่อัตโนมัติ)
task.spawn(function()
    while true do
        if getgenv().AutoBuyEgg then
            pcall(function()
                if getgenv().SelectedEgg and getgenv().SelectedEgg ~= "" then
                    UIActionRemote:FireServer("BuyEgg", getgenv().SelectedEgg)
                end
            end)
        end
        task.wait(0.5) -- ปรับหน่วงเวลาเปิดไข่ตามความเหมาะสม
    end
end)

--------------------------------------------------------------------------------
-- 🎃 ลูปทำงานฟังก์ชัน Halloween
--------------------------------------------------------------------------------

-- 7. ระบบ Auto Collect Lollipop (เก็บอมยิ้มออโต้)
task.spawn(function()
    while true do
        if getgenv().AutoCollectLollipop then
            pcall(function()
                local CurrencyHolder = Workspace.Gameplay.RegionsLoaded.HalloweenEvent.CurrencyPickup.CurrencyHolder
                for _, item in ipairs(CurrencyHolder:GetChildren()) do
                    if not getgenv().AutoCollectLollipop then break end
                    
                    if item.Name == "Lollipop" then
                        CollectCurrencyRemote:FireServer({ item })
                        task.wait(0.05)
                    end
                end
            end)
        end
        task.wait(0.1)
    end
end)

-- 8. ระบบ Auto Attack Boss (ตีบอสฮาโลวีนออโต้)
task.spawn(function()
    while true do
        if getgenv().AutoAttackBoss then
            pcall(function()
                local bossFolder = Workspace.Gameplay.RegionsLoaded.HalloweenEvent.Boss.BossHolder
                local boss = bossFolder:FindFirstChild("Boss")
                
                if boss then
                    SwingSaberRemote:FireServer({ boss })
                end
            end)
        end
        task.wait(0.1)
    end
end)

