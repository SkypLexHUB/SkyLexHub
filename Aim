-- ===== อัปเดต ESP + เส้น + วงกลม FOV + ShiftLock Animation (ทุกเฟรม) =====
local rotAngle = 0
RunService.RenderStepped:Connect(function()
    local Camera = workspace.CurrentCamera
    if not Camera then return end

    local viewportCenter = Camera.ViewportSize / 2

    -- อัปเดตตำแหน่งวงกลม FOV
    if FOVEnabled then
        FOVCircle.Position = viewportCenter
    end

    -- อัปเดตเป้าเล็ง ShiftLock กลางจอ (พร้อมลูกเล่นการหมุนตัววงกลมแบบเท่ๆ)
    if ShiftLockEnabled then
        rotAngle = (rotAngle + 2) % 360
        ShiftLockOuter.Position = viewportCenter
        ShiftLockDot.Position = viewportCenter
        
        -- ทำอนูเมชันขยาย/หดเล็กน้อยตามจังหวะเวลา
        ShiftLockOuter.Radius = 22 + math.sin(tick() * 5) * 3
    end

    if not ESPEnabled then return end

    local origin = Vector2.new(viewportCenter.X, viewportCenter.Y * 2)

    for player, obj in pairs(ESPObjects) do
        local character = player.Character
        local head = character and character:FindFirstChild("Head")
        local root = character and character:FindFirstChild("HumanoidRootPart")

        if head then
            local d = (head.Position - Camera.CFrame.Position).Magnitude
            obj.Label.Text = string.format("%s [%dm]", player.DisplayName, d)
        end

        if LineEnabled and root then
            local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
            if onScreen and pos.Z > 0 then
                local to = Vector2.new(pos.X, pos.Y)
                local delta = to - origin
                obj.Line.Size = UDim2.fromOffset(delta.Magnitude, 2)
                obj.Line.Position = UDim2.fromOffset(
                    (origin.X + to.X) / 2,
                    (origin.Y + to.Y) / 2
                )
                obj.Line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
                obj.Line.Visible = true
            else
                obj.Line.Visible = false
            end
        else
            obj.Line.Visible = false
        end
    end
end)

-- ===== ล็อกกล้องที่ส่วนที่เลือก (Aim Assist & ShiftLock) =====
RunService:BindToRenderStep("AimLockHead", Enum.RenderPriority.Camera.Value + 1, function()
    if not (AimEnabled or ShiftLockEnabled) then return end
    local Camera = workspace.CurrentCamera
    if not Camera then return end

    CurrentTarget = GetNearestTarget()
    local targetPart = CurrentTarget
        and CurrentTarget.Character
        and CurrentTarget.Character:FindFirstChild(SelectedAimPart == "Head" and "Head" or "HumanoidRootPart")

    if targetPart then
        local goal = CFrame.lookAt(Camera.CFrame.Position, targetPart.Position)
        if InstantSnap or ShiftLockEnabled then
            Camera.CFrame = goal -- ดีดล็อกเน้นๆ แบบโหดๆ
        else
            Camera.CFrame = Camera.CFrame:Lerp(goal, Smoothness)
        end
    end
end)

